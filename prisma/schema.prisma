
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}
enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
  AUDIO_TO_TEXT
  AUDIO_TO_TRANSLATION
  VOICE_PRONUNCIATION
}

// ------------------ Users ------------------
model User {
  id           String           @id @default(uuid())
  firstName    String
  lastName     String
  email        String           @unique
  phone        String           @unique
  passwordHash String
  isVerified   Boolean          @default(false)
  role         Role             @default(USER)
  createdAt    DateTime         @default(now())
  lastLogin    DateTime?

  languageId   String?          // clé étrangère optionnelle
  language     Language?        @relation(fields: [languageId], references: [id])

  preferences  UserPreference[]
  series       Series[]
  points       Point[]
  rankings     Ranking[]
  subscriptionsFollowed Subscription[] @relation("followed")
  subscriptionsFollowing Subscription[] @relation("follower")
  progressions Progression[]
  rewards      Reward[]
  feedbacks    Feedback[]
  notifications Notification[]
}

// ------------------ UserPreference ------------------
model UserPreference {
  id                 String          @id @default(uuid())
  user               User            @relation(fields: [userId], references: [id])
  userId             String

  targetLanguage     Language        @relation(fields: [targetLanguageId], references: [id])
  targetLanguageId   String

  goal               Goal?           @relation(fields: [goalId], references: [id])
  goalId             String?         

  referralSource     ReferralSource? @relation(fields: [referralSourceId], references: [id])
  referralSourceId   String?

  createdAt          DateTime        @default(now())
}

model Goal {
  id        String            @id @default(uuid())
  label     String            @unique
  usersPref UserPreference[]
}

model ReferralSource {
  id        String            @id @default(uuid())
  label     String            @unique
  usersPref UserPreference[]
}


// ------------------ Language ------------------
model Language {
  id               String           @id @default(uuid())
  name             String
  languageCode     String

  users            User[]           // 🔹 relation inverse
  userPreferences  UserPreference[]
  progressions     Progression[]
  questions        Question[]
}

// ------------------ Series ------------------
model Series {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  date             DateTime
  lessonsCompleted Int
  learningTime     Int
  currentSeries    Boolean  @default(true)
  streakBonus      Int?
}

// ------------------ Division ------------------
model Division {
  id             String    @id @default(uuid())
  name           String
  pointThreshold Int
  order          Int @unique

  rankings       Ranking[]
}

// ------------------ Ranking ------------------
model Ranking {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  point       Point    @relation(fields: [pointId], references: [id])
  pointId     String
  rank        Int
  division    Division @relation(fields: [divisionId], references: [id])
  divisionId  String
  periodStart DateTime
  periodEnd   DateTime
}

// ------------------ Point ------------------
model Point {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String @unique
  value     Int
  updatedAt DateTime @default(now())

  rankings  Ranking[]
}

// ------------------ Notification ------------------
model Notification {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  type        String
  message     String
  isRead      Boolean  @default(false)
  isBroadcast Boolean  @default(false)
  sentAt      DateTime @default(now())
}

// ------------------ Subscription ------------------
model Subscription {
  id             String   @id @default(uuid())
  user           User     @relation("follower", fields: [userId], references: [id])
  userId         String
  followedUser   User     @relation("followed", fields: [followedUserId], references: [id])
  followedUserId String
  subscribedAt   DateTime @default(now())
  isActive       Boolean  @default(true)
}

// ------------------ Module / Chapter / Lesson ------------------
model Module {
  id          String   @id @default(uuid())
  title       String
  description String
  order       Int @unique
  chapters    Chapter[]
}

model Chapter {
  id        String   @id @default(uuid())
  module    Module   @relation(fields: [moduleId], references: [id])
  moduleId  String
  title     String
  objective String
  order     Int 
  lessons   Lesson[]
}

model Lesson {
  id        String   @id @default(uuid())
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
  chapterId String
  title     String
  objective String
  order     Int 
  questions Question[]

  progressions Progression[]
}

// ------------------ Question / Answer ------------------
model Question {
  id           String   @id @default(uuid())
  lesson       Lesson   @relation(fields: [lessonId], references: [id])
  lessonId     String
  language     Language @relation(fields: [languageId], references: [id])
  languageId   String
  text         String
  audioPath    String?
  imagePath    String?
  order        Int      // pour organiser les questions dans la leçon
  type         QuestionType 
  correctAnswer  String?
  answers      Answer[] // plusieurs réponses possibles
  progressions Progression[]
}

model Answer {
  id         String   @id @default(uuid())
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
  text       String
  isCorrect  Boolean  // vrai si c'est la bonne réponse
}


// ------------------ Progression ------------------
model Progression {
  id            String   @id @default(uuid())
  
  user          User     @relation(fields: [userId], references: [id])
  userId        String

  question      Question @relation(fields: [questionId], references: [id])
  questionId    String

  lesson        Lesson   @relation(fields: [lessonId], references: [id])
  lessonId      String

  language      Language @relation(fields: [languageId], references: [id])
  languageId    String

  userAnswer    String?
  userVoicePath String?
  isCorrect     Boolean
  completed     Boolean  @default(false)
  answeredAt    DateTime @default(now())

  @@index([userId, lessonId, questionId])
}

model Reward {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  type        String
  points      Int
  description String
  grantedAt   DateTime @default(now())
}

// ------------------ Feedback ------------------
model Feedback {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
