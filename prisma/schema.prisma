// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

// ------------------ Users ------------------
model User {
  id          String           @id @default(uuid())
  firstName   String
  lastName    String
  email       String           @unique
  phone       String           @unique
  passwordHash String
  isVerified  Boolean          @default(false)
  role        Role             @default(USER)
  createdAt   DateTime         @default(now())
  lastLogin   DateTime?

  preferences UserPreference[]
  series      Series[]
  points      Point[]
  rankings    Ranking[]
  subscriptionsFollowed Subscription[] @relation("followed")
  subscriptionsFollowing Subscription[] @relation("follower")
  progressions Progression[]
  wallet      Wallet?
  rewards     Reward[]
  feedbacks   Feedback[]
  notifications Notification[]
}

// ------------------ UserPreference ------------------
model UserPreference {
  id                 String          @id @default(uuid())
  user               User            @relation(fields: [userId], references: [id])
  userId             String

  targetLanguage     Language        @relation(fields: [targetLanguageId], references: [id])
  targetLanguageId   String

  goal               Goal            @relation(fields: [goalId], references: [id])
  goalId             String

  referralSource     ReferralSource  @relation(fields: [referralSourceId], references: [id])
  referralSourceId   String

  createdAt          DateTime        @default(now())
}
model Goal {
  id        String            @id @default(uuid())
  label     String             @unique
  usersPref UserPreference[]
}

model ReferralSource {
  id        String            @id @default(uuid())
  label     String             @unique
  usersPref UserPreference[]
}

// ------------------ Language ------------------
model Language {
  id               String           @id @default(uuid())
  name             String
  languageCode     String

  userPreferences  UserPreference[]
}

// ------------------ Series ------------------
model Series {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  date             DateTime
  lessonsCompleted Int
  learningTime     Int
  currentSeries    Boolean  @default(true)
  streakBonus      Int?
}

// ------------------ Division ------------------
model Division {
  id             String    @id @default(uuid())
  name           String
  pointThreshold Int
  order          Int @unique

  rankings       Ranking[]
}

// ------------------ Ranking ------------------
model Ranking {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  point       Point    @relation(fields: [pointId], references: [id])
  pointId     String
  rank        Int
  division    Division @relation(fields: [divisionId], references: [id])
  divisionId  String
  periodStart DateTime
  periodEnd   DateTime
}

// ------------------ Point ------------------
model Point {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  value     Int
  source    String
  updatedAt DateTime @default(now())

  rankings  Ranking[]
}

// ------------------ Notification ------------------
model Notification {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  type        String
  message     String
  isRead      Boolean  @default(false)
  isBroadcast Boolean  @default(false)
  sentAt      DateTime @default(now())
}

// ------------------ Subscription ------------------
model Subscription {
  id             String   @id @default(uuid())
  user           User     @relation("follower", fields: [userId], references: [id])
  userId         String
  followedUser   User     @relation("followed", fields: [followedUserId], references: [id])
  followedUserId String
  subscribedAt   DateTime @default(now())
  isActive       Boolean  @default(true)
}

// ------------------ Module / Chapter / Lesson ------------------
model Module {
  id          String   @id @default(uuid())
  title       String
  description String
  order       Int @unique
  chapters    Chapter[]
}

model Chapter {
  id        String   @id @default(uuid())
  module    Module   @relation(fields: [moduleId], references: [id])
  moduleId  String
  title     String
  objective String
  order     Int @unique
  lessons   Lesson[]
}

model Lesson {
  id        String   @id @default(uuid())
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
  chapterId String
  title     String
  objective String
  order     Int @unique
  questions Question[]
}

// ------------------ Question / Answer ------------------
model Question {
  id               String       @id @default(uuid())
  lesson           Lesson       @relation(fields: [lessonId], references: [id])
  lessonId         String
  text             String
  correctAnswerId  String?
  order            Int @unique
  audioPath        String?
  imagePath        String?
  answers          Answer[]
  progressions     Progression[]
}

model Answer {
  id         String   @id @default(uuid())
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
  text       String
  isCorrect  Boolean
  order      Int @unique
}

// ------------------ Progression ------------------
model Progression {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  question      Question @relation(fields: [questionId], references: [id])
  questionId    String
  lessonId      String
  userAnswer    String?
  userVoicePath String?
  isCorrect     Boolean
  answeredAt    DateTime @default(now())
}

// ------------------ Wallet / Transaction / Reward ------------------
model Wallet {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  balance     String
  lastUpdated DateTime     @default(now())
  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(uuid())
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  walletId  String
  type      String
  amount    Float
  status    String
  date      DateTime @default(now())
}

model Reward {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  type        String
  points      Int
  description String
  grantedAt   DateTime @default(now())
}

// ------------------ Feedback ------------------
model Feedback {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
